# M3U Editör Pro - Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın ve değerleri düzenleyin

# Sunucu Ayarları
SERVER_PORT=8501
SERVER_HOST=127.0.0.1

# Güvenlik
ENABLE_SSL_VERIFY=true
MAX_FILE_SIZE_MB=50
REQUEST_TIMEOUT=30
ALLOW_PRIVATE_NETWORKS=false
ENABLE_LAN_SHARING=false
PROXY_PORT=8502
# Uzak sunucuda HTTPS reverse proxy ile /relay/ -> 127.0.0.1:8502/ yönlendirin.
PROXY_PUBLIC_BASE_URL=
PROXY_ALLOWED_ORIGIN=
UPSTREAM_PROXY=

# Özellikler
ENABLE_VISITOR_COUNTER=true
ENABLE_LIVE_PLAYER=true
ENABLE_URL_HEALTH_CHECK=true

# Varsayılan Ayarlar
DEFAULT_TR_FILTER=true
